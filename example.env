# ============================================================================
# SmartMarketOOPS - Unified Environment Configuration
# ============================================================================
# This is the consolidated environment configuration file.
# Copy this to .env and update with your actual values.
#
# SECURITY NOTE: Never commit .env files with real credentials to version control!
# ============================================================================

# ============================================================================
# SYSTEM & SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development                    # development | production | test
TRADING_MODE=test                       # test | live (CRITICAL: affects real money)
HOST=0.0.0.0                            # Server host
BACKEND_PORT=3006                       # Backend API port
FRONTEND_PORT=3000                      # Frontend development port
WEBSOCKET_PORT=3001                     # WebSocket server port for real-time data
ML_PORT=8000                            # ML service port

# ============================================================================
# DATABASE & CACHE CONFIGURATION
# ============================================================================
# PostgreSQL Main Database
DATABASE_URL="postgresql://smoops_user:smoops_password@localhost:5432/smartmarketoops"

# QuestDB (Time-Series Database)
QUESTDB_HOST="localhost"
QUESTDB_HTTP_PORT="9000"
QUESTDB_ILP_PORT="9009"
QUESTDB_PG_PORT="8812"

# Redis (Cache & Event-Driven Architecture)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# Generate strong, random secrets for production environments
JWT_SECRET="your-super-secret-jwt-key-here-change-this"
JWT_EXPIRES_IN="1h"
ENCRYPTION_KEY="your-32-byte-encryption-key-for-api-secrets" # Must be 32 bytes

# ============================================================================
# API & CLIENT CONFIGURATION
# ============================================================================
# URLs used by the frontend to communicate with the backend
NEXT_PUBLIC_API_URL="http://localhost:3006"
CORS_ORIGIN="http://localhost:3000"

# ============================================================================
# DELTA EXCHANGE API CONFIGURATION
# ============================================================================
# CRITICAL: These are EXAMPLE keys. Replace with your actual Delta Exchange credentials.
# Get your API keys from: https://www.delta.exchange/app/account/api
DELTA_EXCHANGE_API_KEY="AjTdJYCVE3aMZDAVQ2r6AQdmkU2mWc"
DELTA_EXCHANGE_API_SECRET="R29RkXJfUIIt4o3vCDXImyg6q74JvByYltVKFH96UJG51lR1mm88PCGnMrUR"
DELTA_EXCHANGE_TESTNET="true" # Set to "false" for live trading
DELTA_EXCHANGE_BASE_URL="https://api.delta.exchange" # Use "https://api.testnet.delta.exchange" for testnet

# ============================================================================
# AI & ML CONFIGURATION
# ============================================================================
# ML Service Endpoint
ML_MODEL_ENDPOINT="http://localhost:8000"

# Optional: Keys for external AI providers if you extend the system
OPENAI_API_KEY="your-openai-api-key-here"
OPENROUTER_API_KEY="your-openrouter-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL="info"                        # debug | info | warn | error
ENABLE_DEBUG_LOGS="false"

# ============================================================================
# TRADING BEHAVIOR
# ============================================================================
ENABLE_PAPER_TRADING="true"             # If true, trades are simulated instead of executed
MARKET_DATA_UPDATE_INTERVAL="5"         # In seconds
DEFAULT_POSITION_SIZE="0.1"             # Default trade size
MAX_DAILY_TRADES="50"                   # Risk management: max trades per day

# ============================================================================
# PERFORMANCE & RATE LIMITING
# ============================================================================
API_RATE_LIMIT="100"                    # Max requests per minute to your API
CACHE_TTL="300"                         # Cache time-to-live in seconds
MAX_CONCURRENT_CONNECTIONS="100"
